# Copy this file to .env and fill in real values. .env is gitignored.

# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: market data provider: yahoo (default, yfinance) or simulator
MARKET_DATA_PROVIDER=yahoo

# Optional: "true" returns deterministic mock LLM responses (testing, no API calls)
LLM_MOCK=false
